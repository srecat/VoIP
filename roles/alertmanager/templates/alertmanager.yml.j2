global:
  resolve_timeout: 5m
  smtp_smarthost: '{{ smtp_smarthost }}'
  smtp_from: '{{ smtp_from }}'
  smtp_auth_username: '{{ smtp_auth_username }}'
  smtp_auth_password: '{{ smtp_auth_password }}'
  smtp_require_tls: true

route:
  group_by: ['alertname']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 3h
  receiver: 'email-notifications'

receivers:
  - name: 'email-notifications'
    email_configs:
      - to: '{{ alert_email_to }}'
        send_resolved: true
